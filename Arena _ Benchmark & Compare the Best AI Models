<tr><td>Heavy water (Dâ‚‚O) / deuterium</td><td class="num">2</td><td class="num">0.111</td><td class="num">0.725</td><td class="num">â‰ˆ 25</td></tr>
<tr><td>Graphite (carbon)</td><td class="num">12</td><td class="num">0.716</td><td class="num">0.158</td><td class="num">â‰ˆ 115</td></tr>
<tr><td>Lead</td><td class="num">207</td><td class="num">0.981</td><td class="num">0.0095</td><td class="num">â‰ˆ 1900</td></tr>
