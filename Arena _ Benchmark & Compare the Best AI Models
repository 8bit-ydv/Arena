<tbody>
<tr><td><span class="m">r<sub>vdW</sub></span></td><td class="num">1.20</td><td class="num">1.70</td><td class="num">1.55</td><td class="num">1.52</td><td class="num">1.47</td><td class="num">1.80</td><td class="num">1.85</td><td class="num">1.98</td></tr>
</tbody>
</table>
</div>

