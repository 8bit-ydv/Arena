<tr><td>Mâ€“M bond enthalpy (kJ/mol)</td><td class="num">347</td><td class="num">222</td><td class="num">â‰ˆ 167</td><td class="num">â‰ˆ 155</td><td class="num">â‰ˆ 150</td></tr>
